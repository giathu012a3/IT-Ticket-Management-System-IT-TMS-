# PyInstaller
#  Usually these files are written by a standalone easy_install, for example
#  python2.4 easy_install all-requirements.txt
#  becomes
#  python2.4 all-requirements.txt
#  which is why we ignore it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

